      <script>
        <segment name="Fortran" id="367631234" classid="CoreSegment"><![CDATA[#CASE IDir {!Inverse Clark~}{!Clark~}
~ transformation
#IF cq==1
 #IF IDir==1
      $XCL(1)= SQRT_1BY2*SQRT_1BY3*(2.0*$XNAT(1)-$XNAT(2)-$XNAT(3))
      $XCL(2)= SQRT_1BY2*($XNAT(2)-$XNAT(3))
      $XCL(3)= SQRT_1BY3*($XNAT(1)+$XNAT(2)+$XNAT(3))
 #ELSE
      $XNAT(1) = SQRT_1BY3*(SQRT_2*$XCL(1)+ $XCL(3))
      $XNAT(2) = SQRT_1BY2*SQRT_1BY3*(-$XCL(1)+ SQRT_3*$XCL(2)+ SQRT_2*$XCL(3))
      $XNAT(3) = SQRT_1BY2*SQRT_1BY3*(-$XCL(1)- SQRT_3*$XCL(2)+ SQRT_2*$XCL(3))
 #ENDIF
#ELSEIF cq==0
 #IF IDir==1
      $XCL(1)= ONE_3RD*(2.0*$XNAT(1)-$XNAT(2)-$XNAT(3))
      $XCL(2)= SQRT_1BY3*($XNAT(2)-$XNAT(3))
      $XCL(3)= ONE_3RD*($XNAT(1)+$XNAT(2)+$XNAT(3))
 #ELSE
      $XNAT(1) = $XCL(1) + $XCL(3)
      $XNAT(2) = 0.5*(-$XCL(1)+ SQRT_3*$XCL(2)) + $XCL(3)
      $XNAT(3) = 0.5*(-$XCL(1)- SQRT_3*$XCL(2)) + $XCL(3)
 #ENDIF
#ENDIF]]></segment>
        <segment name="Computations" id="36560092" classid="CoreSegment"><![CDATA[INTEGER IDir2 = 2*IDir-1]]></segment>
        <segment classid="CoreSegment" id="802663650" name="FlyBy"><![CDATA[Clarke Transformation]]></segment>
      </script>
