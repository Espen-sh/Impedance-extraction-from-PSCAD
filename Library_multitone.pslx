      <script>
        <segment name="Fortran" id="1975735058" classid="CoreSegment"><![CDATA[      $OUT = $IN1 * $IN2]]></segment>
        <segment name="FlyBy" id="328722436" classid="CoreSegment"><![CDATA[Multiplier
:IN1
Input1
:IN2
Input2
:OUT
Output]]></segment>
        <segment name="Checks" id="2054455858" classid="CoreSegment"><![CDATA[#IF ($#DIM(IN1)== $#DIM(IN2))&&(Dim==$#DIM(IN1))
WARNING nothing wrong : 1==1
#ELSEIF ($#DIM(IN1)==Dim)&&($#DIM(IN2)==1)
WARNING nothing wrong : 1==1
#ELSEIF ($#DIM(IN2)==Dim)&&($#DIM(IN1)==1)
WARNING nothing wrong : 1==1
#ELSE
 #IF ($#DIM(IN1)==1) && ($#DIM(IN2)!=Dim)
ERROR Dimension of one of the inputs is neither unity nor the dimension of the output : 1==0
 #ELSEIF ($#DIM(IN2)==1) && ($#DIM(IN1)!=Dim)
ERROR Dimension of one of the inputs is neither unity nor the dimension of the output : 1==0
 #ELSEIF ($#DIM(IN2)!= $#DIM(IN1)&& Dim>1)
ERROR Dimension mismatch : 1==0
 #ENDIF
#ENDIF]]></segment>
        <segment classid="CoreSegment" id="193957003" name="C"><![CDATA[#INCLUDE $(HomeDir)\CCoder\stdinc.pds
#IF Dim == 1
  #IF DPath!=2
$OUT = $IN1 * $IN2;
  #ELSE
$OUT = $CMult($IN1, $IN2);
  #ENDIF
#Else
#LOCAL INTEGER i
for (i = 0; i < $Dim; i++) {
  #IF DPath!=2
	$OUT[i] = $IN1[i] * $IN2[i];
  #ELSE
	$OUT[i] = $CMult($IN1[i], $IN2[i]);
  #ENDIF
}
#ENDIF]]></segment>
      </script>
