      <form name="" splitter="60" w="320" h="400" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="opt" desc="To or from pu" type="Choice" group="" helpmode="Append" animate="false">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
            <choice><![CDATA[0 = SI -> pu]]></choice>
            <choice><![CDATA[1 = pu -> SI]]></choice>
          </parameter>
          <parameter type="Choice" name="DPath" desc="Data Path Type:" helpmode="Overwrite" group="" animate="false">
            <value><![CDATA[2]]></value>
            <cond type="Enable" />
            <help><![CDATA[Select whether output and inputs are real, integers or complex numbers]]></help>
            <vis />
            <choice><![CDATA[0 = Integer]]></choice>
            <choice><![CDATA[1 = Real]]></choice>
            <choice><![CDATA[2 = Complex]]></choice>
          </parameter>
          <parameter name="Dim" desc="Output Dimension" type="Integer" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" unit="" min="1" max="2147483647" animate="false">
            <value><![CDATA[1]]></value>
            <cond type="Enable"><![CDATA[true]]></cond>
            <help><![CDATA[Enter the dimension of output based on dimensions of inputs]]></help>
            <vis />
          </parameter>
          <parameter name="base" desc="Base value" type="Real" group="" helpmode="Append" content_type="Constant" intent="Input" dim="1" animate="false" unit="" min="-1E+308" max="1E+308">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Computations" id="562324755" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Fortran" id="617756997" classid="CoreSegment"><![CDATA[
    IF ($opt .EQ. 0) THEN
        $OUT = $IN1 *(1/ $base)

    ELSE
        $OUT = $IN1 * $base

    ENDIF]]></segment>
      </script>
    </Definition>
