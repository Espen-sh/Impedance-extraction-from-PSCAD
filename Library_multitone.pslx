        <Gfx classid="Graphics.Line" id="311960526" x="0" y="39">
          <vertex x="0" y="0" />
          <vertex x="0" y="15" />
          <paramlist>
            <param name="color" value="Green" />
            <param name="dasharray" value="0" />
            <param name="thickness" value="0" />
