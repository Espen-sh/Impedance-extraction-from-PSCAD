      <form name="Clarke Transformation" w="320" h="420" splitter="60" commentlines="4" help-width="490">
        <category name="Configuration" visible="true" splitter="60">
          <parameter type="Text" name="Name" desc="Name" group="" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond />
            <help><![CDATA[Optional name for easy identification]]></help>
            <regex />
