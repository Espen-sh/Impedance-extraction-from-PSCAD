      <script>
        <segment name="Fortran" id="1586924748" classid="CoreSegment"><![CDATA[      #BEGIN
          CALL E_BRANCH_CFG($BRN,$SS,0,0,0,0,0,0) 
      #ENDBEGIN 
      #STORAGE REAL:1 
      #LOCAL REAL XU
      #LOCAL INTEGER MY_STORF
      MY_STORF = NSTORF
      NSTORF = NSTORF + 1
      IF (TIMEZERO) THEN
        STORF(MY_STORF) = $V_INIT
      ENDIF
      XU = STORF(MY_STORF)
      XU = XU - CBR($BRN,$SS)/($CAP/1000.0)*DELT
      EBR($BRN,$SS) = XU
      STORF(MY_STORF) = XU]]></segment>
        <segment name="Branch" id="2141414397" classid="CoreSegment"><![CDATA[BRN = $B $A Source 0 0 0]]></segment>
        <segment name="Computations" id="825563808" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
