      <script>
        <segment name="Fortran" id="244291583" classid="CoreSegment"><![CDATA[!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! DIRECTIVES !!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!

#LOCAL INTEGER N
#LOCAL INTEGER ISET
#LOCAL INTEGER NTONE

#LOCAL REAL F
#LOCAL REAL W
#LOCAL REAL SGN
#LOCAL REAL SUMA
#LOCAL REAL SUMB
#LOCAL REAL SUMC
#LOCAL REAL VINJ
#LOCAL REAL TWOPI
#LOCAL REAL PI
#LOCAL REAL PH120
#LOCAL REAL PHI


! EXEC

      SUMA  = 0.0
      SUMB  = 0.0
      SUMC  = 0.0

      VINJ  = 565.69 * 0.025 * 0.01

      PI    = 3.141592653589793
      TWOPI = 6.283185307179586
      PH120 = 2.094395102393195

      SGN = 1.0
      IF ($sequence .LT. 0.0) SGN = -1.0

      ISET = NINT($f_list)

      IF (ISET .LT. 1) ISET = 1
      IF (ISET .GT. 6) ISET = 6

      NTONE = 24
      IF (ISET .EQ. 5) NTONE = 40
      IF (ISET .EQ. 6) NTONE = 40

      DO N = 1, NTONE

         F = 1.0

         SELECT CASE (ISET)

         CASE (1)

            SELECT CASE (N)

            CASE (1)
               F = 1.0
            CASE (2)
               F = 10.0
            CASE (3)
               F = 53.0
            CASE (4)
               F = 56.0
            CASE (5)
               F = 103.0
            CASE (6)
               F = 106.0
            CASE (7)
               F = 211.0
            CASE (8)
               F = 216.0
            CASE (9)
               F = 5.0
            CASE (10)
               F = 16.0
            CASE (11)
               F = 65.0
            CASE (12)
               F = 68.0
            CASE (13)
               F = 126.0
            CASE (14)
               F = 130.0
            CASE (15)
               F = 286.0
            CASE (16)
               F = 301.0
            CASE (17)
               F = 9.0
            CASE (18)
               F = 24.0
            CASE (19)
               F = 80.0
            CASE (20)
               F = 172.0
            CASE (21)
               F = 155.0
            CASE (22)
               F = 159.0
            CASE (23)
               F = 477.0
            CASE (24)
               F = 515.0

            END SELECT

         CASE (2)

            SELECT CASE (N)

            CASE (1)
               F = 2.0
            CASE (2)
               F = 12.0
            CASE (3)
               F = 54.0
            CASE (4)
               F = 57.0
            CASE (5)
               F = 108.0
            CASE (6)
               F = 111.0
            CASE (7)
               F = 222.0
            CASE (8)
               F = 176.0
            CASE (9)
               F = 6.0
            CASE (10)
               F = 22.0
            CASE (11)
               F = 40.0
            CASE (12)
               F = 70.0
            CASE (13)
               F = 133.0
            CASE (14)
               F = 136.0
            CASE (15)
               F = 317.0
            CASE (16)
               F = 333.0
            CASE (17)
               F = 26.0
            CASE (18)
               F = 28.0
            CASE (19)
               F = 82.0
            CASE (20)
               F = 86.0
            CASE (21)
               F = 163.0
            CASE (22)
               F = 167.0
            CASE (23)
               F = 556.0
            CASE (24)
               F = 600.0

            END SELECT

         CASE (3)

            SELECT CASE (N)

            CASE (1)
               F = 3.0
            CASE (2)
               F = 11.0
            CASE (3)
               F = 59.0
            CASE (4)
               F = 62.0
            CASE (5)
               F = 114.0
            CASE (6)
               F = 117.0
            CASE (7)
               F = 239.0
            CASE (8)
               F = 245.0
            CASE (9)
               F = 18.0
            CASE (10)
               F = 20.0
            CASE (11)
               F = 72.0
            CASE (12)
               F = 76.0
            CASE (13)
               F = 140.0
            CASE (14)
               F = 144.0
            CASE (15)
               F = 351.0
            CASE (16)
               F = 379.0
            CASE (17)
               F = 32.0
            CASE (18)
               F = 36.0
            CASE (19)
               F = 88.0
            CASE (20)
               F = 93.0
            CASE (21)
               F = 84.0
            CASE (22)
               F = 67.0
            CASE (23)
               F = 682.0
            CASE (24)
               F = 775.0

            END SELECT

         CASE (4)

            SELECT CASE (N)

            CASE (1)
               F = 4.0
            CASE (2)
               F = 14.0
            CASE (3)
               F = 60.0
            CASE (4)
               F = 63.0
            CASE (5)
               F = 120.0
            CASE (6)
               F = 123.0
            CASE (7)
               F = 258.0
            CASE (8)
               F = 272.0
            CASE (9)
               F = 8.0
            CASE (10)
               F = 7.0
            CASE (11)
               F = 74.0
            CASE (12)
               F = 78.0
            CASE (13)
               F = 147.0
            CASE (14)
               F = 151.0
            CASE (15)
               F = 409.0
            CASE (16)
               F = 442.0
            CASE (17)
               F = 233.0
            CASE (18)
               F = 44.0
            CASE (19)
               F = 91.0
            CASE (20)
               F = 95.0
            CASE (21)
               F = 190.0
            CASE (22)
               F = 200.0
            CASE (23)
               F = 880.0
            CASE (24)
               F = 1000.0

            END SELECT

         CASE (5)

            SELECT CASE (N)

            CASE (1)
               F = 173.0
            CASE (2)
               F = 174.0
            CASE (3)
               F = 175.0
            CASE (4)
               F = 177.0
            CASE (5)
               F = 178.0
            CASE (6)
               F = 179.0
            CASE (7)
               F = 180.0
            CASE (8)
               F = 181.0
            CASE (9)
               F = 182.0
            CASE (10)
               F = 183.0
            CASE (11)
               F = 184.0
            CASE (12)
               F = 185.0
            CASE (13)
               F = 186.0
            CASE (14)
               F = 187.0
            CASE (15)
               F = 188.0
            CASE (16)
               F = 189.0
            CASE (17)
               F = 191.0
            CASE (18)
               F = 192.0
            CASE (19)
               F = 193.0
            CASE (20)
               F = 194.0
            CASE (21)
               F = 195.0
            CASE (22)
               F = 196.0
            CASE (23)
               F = 197.0
            CASE (24)
               F = 198.0
            CASE (25)
               F = 199.0
            CASE (26)
               F = 201.0
            CASE (27)
               F = 202.0
            CASE (28)
               F = 203.0
            CASE (29)
               F = 204.0
            CASE (30)
               F = 205.0
            CASE (31)
               F = 206.0
            CASE (32)
               F = 207.0
            CASE (33)
               F = 208.0
            CASE (34)
               F = 209.0
            CASE (35)
               F = 210.0
            CASE (36)
               F = 212.0
            CASE (37)
               F = 213.0
            CASE (38)
               F = 214.0
            CASE (39)
               F = 215.0
            CASE (40)
               F = 217.0

            END SELECT

         CASE (6)

            SELECT CASE (N)

            CASE (1)
               F = 273.0
            CASE (2)
               F = 275.0
            CASE (3)
               F = 277.0
            CASE (4)
               F = 279.0
            CASE (5)
               F = 281.0
            CASE (6)
               F = 282.0
            CASE (7)
               F = 283.0
            CASE (8)
               F = 284.0
            CASE (9)
               F = 285.0
            CASE (10)
               F = 287.0
            CASE (11)
               F = 288.0
            CASE (12)
               F = 289.0
            CASE (13)
               F = 290.0
            CASE (14)
               F = 291.0
            CASE (15)
               F = 292.0
            CASE (16)
               F = 293.0
            CASE (17)
               F = 294.0
            CASE (18)
               F = 295.0
            CASE (19)
               F = 296.0
            CASE (20)
               F = 297.0
            CASE (21)
               F = 298.0
            CASE (22)
               F = 299.0
            CASE (23)
               F = 302.0
            CASE (24)
               F = 303.0
            CASE (25)
               F = 304.0
            CASE (26)
               F = 305.0
            CASE (27)
               F = 306.0
            CASE (28)
               F = 307.0
            CASE (29)
               F = 308.0
            CASE (30)
               F = 309.0
            CASE (31)
               F = 310.0
            CASE (32)
               F = 311.0
            CASE (33)
               F = 312.0
            CASE (34)
               F = 313.0
            CASE (35)
               F = 314.0
            CASE (36)
               F = 315.0
            CASE (37)
               F = 316.0
            CASE (38)
               F = 318.0
            CASE (39)
               F = 320.0
            CASE (40)
               F = 323.0

            END SELECT

         END SELECT

         PHI = PI * (N-1) * (N-2) / FLOAT(NTONE)

         W = TWOPI * (F + SGN*50.0)

         SUMA = SUMA + SIN(W*TIME + PHI)
         SUMB = SUMB + SIN(W*TIME + PHI - SGN*PH120)
         SUMC = SUMC + SIN(W*TIME + PHI + SGN*PH120)

      ENDDO

      $Vainj = VINJ * SUMA
      $Vbinj = VINJ * SUMB
      $Vcinj = VINJ * SUMC]]></segment>
      </script>
    </Definition>
