          </paramlist>
        </Gfx>
        <Gfx classid="Graphics.Line" id="246422294" x="0" y="39">
          <vertex x="0" y="0" />
          <vertex x="5" y="5" />
          <paramlist>
            <param name="color" value="Green" />
            <param name="dasharray" value="0" />
