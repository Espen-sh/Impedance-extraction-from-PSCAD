            <vis />
          </parameter>
          <cond />
          <parameter type="Choice" name="IDir" desc="Direction of Transformation" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[1]]></value>
            <cond />
            <help><![CDATA[This component can transform values in either direction. Select which direction you would like to use.]]></help>
            <vis />
            <choice><![CDATA[0 = alpha-beta to ABC]]></choice>
            <choice><![CDATA[1 = ABC to alpha-beta]]></choice>
          </parameter>
          <parameter name="cq" desc="Clarke Quantities" type="Choice" group="" helpmode="Overwrite" animate="false">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[Select Standard or Power Invariant]]></help>
            <choice><![CDATA[0 = Standard]]></choice>
            <choice><![CDATA[1 = Power Invariant]]></choice>
          </parameter>
        </category>
      </form>
