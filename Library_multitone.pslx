        <Gfx classid="Graphics.Text" id="1147678619" x="-36" y="11">
          <paramlist>
            <param name="text" value="Voltage Injection" />
            <param name="anchor" value="0" />
            <param name="full_font" value="Tahoma, 9world" />
            <param name="angle" value="0" />
            <param name="color" value="Black" />
            <param name="cond" value="true" />
          </paramlist>
        </Gfx>
      </graphics>
      <form name="Injects Multi Tone Voltage Signal." splitter="60">
        <category name="Configuration" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Fortran" id="1352000790" classid="CoreSegment"><![CDATA[! EXEC

      sumA = 0.0
      sumB = 0.0
      sumC = 0.0

      Vinj = 0.004
      

      sgn = -1

      w = 6.283185307179586 * ( f + sgn*50.0 )

      DO n = 1, 23

         IF (n .EQ. 1) THEN
            f = 1.0
         ELSEIF (n .EQ. 2) THEN
            f = 2.0
         ELSEIF (n .EQ. 3) THEN
            f = 3.0
         ELSEIF (n .EQ. 4) THEN
            f = 4.0
         ELSEIF (n .EQ. 5) THEN
            f = 5.0
         ELSEIF (n .EQ. 6) THEN
            f = 7.0
         ELSEIF (n .EQ. 7) THEN
            f = 9.0
         ELSEIF (n .EQ. 8) THEN
            f = 12.0
         ELSEIF (n .EQ. 9) THEN
            f = 16.0
         ELSEIF (n .EQ. 10) THEN
            f = 22.0
         ELSEIF (n .EQ. 11) THEN
            f = 30.0
         ELSEIF (n .EQ. 12) THEN
            f = 40.0
         ELSEIF (n .EQ. 13) THEN
            f = 54.0
         ELSEIF (n .EQ. 14) THEN
            f = 73.0
         ELSEIF (n .EQ. 15) THEN
            f = 99.0
         ELSEIF (n .EQ. 16) THEN
            f = 134.0
         ELSEIF (n .EQ. 17) THEN
            f = 181.0
         ELSEIF (n .EQ. 18) THEN
            f = 244.0
         ELSEIF (n .EQ. 19) THEN
            f = 330.0
         ELSEIF (n .EQ. 20) THEN
            f = 445.0
         ELSEIF (n .EQ. 21) THEN
            f = 601.0
         ELSEIF (n .EQ. 22) THEN
            f = 812.0
         ELSE
            f = 1000.0
         ENDIF

         ! omega = 2*pi*(f +/- 50)  using sign = 1 or -1
         w = 6.283185307179586 * abs( f + 50.0*(sgn) )

         sumA = sumA + SIN( w*TIME + 0.0 )
         sumB = sumB + SIN( w*TIME - (sgn)*2.094395102393195 )
         sumC = sumC + SIN( w*TIME + (sgn)*2.094395102393195 )

      ENDDO

      $Vainj = Vinj * sumA
      $Vbinj = Vinj * sumB
      $Vcinj = Vinj * sumC]]></segment>
      </script>
    </Definition>
