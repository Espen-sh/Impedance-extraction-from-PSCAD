            <vis />
          </parameter>
          <parameter name="C" desc="C" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="F" min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="L" desc="L" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="H" min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="TDEL" desc="TDEL" type="Real" group="" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="S" min="-1E+308" max="1E+308">
            <value><![CDATA[0]]></value>
            <cond><![CDATA[true]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Fortran" id="1181317489" classid="CoreSegment"><![CDATA[!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!! DIRECTIVES !!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!

#STORAGE REAL:50

! Integer locals
#LOCAL INTEGER K0      ! Base index into the storage array STORF
#LOCAL INTEGER NIT     ! Number of iterations for bisection root solve
#LOCAL INTEGER ITR     ! Iteration counter

! Real locals: constants and derived TCSC quantities
#LOCAL REAL PI         ! pi
#LOCAL REAL FN         ! Nominal system frequency [Hz]
#LOCAL REAL L          ! TCSC reactor inductance [H] (input parameter)
#LOCAL REAL C          ! TCSC capacitor capacitance [F] (input parameter)
#LOCAL REAL WN         ! Nominal angular frequency = 2*pi*FN [rad/s]
#LOCAL REAL W0         ! Natural angular frequency of LC branch = 1/sqrt(L*C) [rad/s]
#LOCAL REAL LAM        ! Lambda = W0/WN
#LOCAL REAL X0         ! Characteristic reactance = W0*L [ohm]

! Real locals: pulse generation and numerical guards
#LOCAL REAL PWID       ! Output pulse width [s]
#LOCAL REAL CMIN       ! Small current threshold to avoid sign ambiguity / bad solve
#LOCAL REAL EPS        ! Small threshold to avoid division by a very small denominator
#LOCAL REAL TDEL       ! Delay from RefPulse to desired capacitor zero crossing TZ [s]

! Real locals: predicted zero-crossing quantities
#LOCAL REAL REFED      ! Rising-edge detector flag for RefPulse
#LOCAL REAL DTZ        ! Time remaining until desired zero crossing: TZ - TIME
#LOCAL REAL UCZ        ! Predicted capacitor voltage at desired zero crossing TZ
#LOCAL REAL YVAL       ! Normalized predicted voltage term used in SVR equation

! Real locals: root solver variables
#LOCAL REAL BETA       ! Solved firing angle 
#LOCAL REAL BLOW       ! Lower bound of beta interval
#LOCAL REAL BHIGH      ! Upper bound of beta interval
#LOCAL REAL BMID       ! Midpoint of beta interval
#LOCAL REAL FLOW       ! Function value at BLOW
#LOCAL REAL FHIGH      ! Function value at BHIGH
#LOCAL REAL FMID       ! Function value at BMID
#LOCAL REAL ARG        ! Temporary variable for lambda*beta
#LOCAL REAL MARG       ! Small margin to stay away from singular endpoints

! Real locals: stored event state
#LOCAL REAL PREF       ! Previous RefPulse value, used for rising-edge detection
#LOCAL REAL ARMF       ! "Forward event armed" flag
#LOCAL REAL ARMR       ! "Reverse event armed" flag
#LOCAL REAL TZ         ! Desired capacitor voltage zero-crossing time
#LOCAL REAL TFIRE      ! Computed firing time for the currently armed thyristor
#LOCAL REAL GTF        ! Remaining pulse width time for forward output FP
#LOCAL REAL GTR        ! Remaining pulse width time for reverse output RP

! EXEC

      !---------------------------------------------------------------
      ! K0 is the starting index in the storage array STORF.
      ! This block stores its internal state in STORF(K0+1 ... K0+7).
      !---------------------------------------------------------------
      K0 = NSTORF

      !---------------------------------------------------------------
      ! Initialize internal stored states on the first simulation step.
      !
      ! Stored variables:
      !   K0+1 : previous RefPulse
      !   K0+2 : ARMF
      !   K0+3 : ARMR
      !   K0+4 : TZ
      !   K0+5 : TFIRE
      !   K0+6 : GTF
      !   K0+7 : GTR
      !---------------------------------------------------------------
      IF (FIRSTSTEP) THEN
         STORF(K0+1) = 0.0
         STORF(K0+2) = 0.0
         STORF(K0+3) = 0.0
         STORF(K0+4) = 0.0
         STORF(K0+5) = 0.0
         STORF(K0+6) = 0.0
         STORF(K0+7) = 0.0
      ENDIF

      !---------------------------------------------------------------
      ! Read back stored state variables from previous timestep.
      !---------------------------------------------------------------
      PREF  = STORF(K0+1)
      ARMF  = STORF(K0+2)
      ARMR  = STORF(K0+3)
      TZ    = STORF(K0+4)
      TFIRE = STORF(K0+5)
      GTF   = STORF(K0+6)
      GTR   = STORF(K0+7)

      !---------------------------------------------------------------
      ! Basic constants.
      !---------------------------------------------------------------
      PI   = 3.141592653589793
      FN   = 50.0

      !---------------------------------------------------------------
      ! Input parameters to the block.
      !---------------------------------------------------------------
      L = $L
      C = $C

      !---------------------------------------------------------------
      ! Derived TCSC quantities.
      !
      ! WN  = nominal system angular frequency
      ! W0  = natural LC angular frequency
      ! LAM = normalized resonance frequency
      ! X0  = characteristic LC reactance
      !---------------------------------------------------------------
      WN  = 2.0*PI*FN
      W0  = 1.0/SQRT(L*C)
      LAM = W0/WN
      X0  = W0*L

      !---------------------------------------------------------------
      ! Tuning / numerical parameters.
      !---------------------------------------------------------------
      PWID = 1.0E-4     ! Output pulse width = 100 microseconds
      CMIN = 1.0E-6     ! Current threshold
      EPS  = 1.0E-9     ! Denominator threshold

      !---------------------------------------------------------------
      ! Must match the delay used when generating the reference pulse.
      !---------------------------------------------------------------
      TDEL = $TDEL

      !---------------------------------------------------------------
      ! Root solver settings.
      ! NIT  = how many bisection steps to perform
      ! MARG = Margin from 0 and pi/2 singular endpoints
      !---------------------------------------------------------------
      NIT  = 30
      MARG = 1.0E-6

      !---------------------------------------------------------------
      ! Default outputs each timestep.
      ! They only become 1.0 if pulse timers GTF/GTR are active.
      !---------------------------------------------------------------
      $FP = 0.0
      $RP = 0.0

      !---------------------------------------------------------------
      ! Rising-edge detector for RefPulse.
      ! REFED becomes 1.0 for one timestep when RefPulse rises
      !---------------------------------------------------------------
      REFED = 0.0
      IF ($RefPulse .GT. 0.5 .AND. PREF .LE. 0.5) REFED = 1.0

      !---------------------------------------------------------------
      ! Accept a new reference only if no other event is already armed.
      ! ARMF = forward thyristor event waiting to fire
      ! ARMR = reverse thyristor event waiting to fire
      !---------------------------------------------------------------
      IF (REFED .GT. 0.5) THEN
         IF (ARMF .LT. 0.5 .AND. ARMR .LT. 0.5) THEN

            !--------------------------------------------------------
            ! Decide which thyristor to arm from present physical state.
            !   If reactor current is positive, arm reverse thyristor
            !   If reactor current is negative, arm forward thyristor
            ! If current is too small to decide reliably, fall back
            ! to the capacitor voltage sign.
            !--------------------------------------------------------
            IF ($iL .GT. CMIN) THEN
               ARMR = 1.0
               ARMF = 0.0
            ELSEIF ($iL .LT. -CMIN) THEN
               ARMF = 1.0
               ARMR = 0.0
            ELSE
               !-----------------------------------------------------
               ! Fallback decision at very small current.
               ! If uC > 0, arm forward
               ! If uC < 0, arm reverse
               ! Otherwise arm nothing
               !-----------------------------------------------------
               IF ($uC .GT. 0.0) THEN
                  ARMF = 1.0
                  ARMR = 0.0
               ELSEIF ($uC .LT. 0.0) THEN
                  ARMR = 1.0
                  ARMF = 0.0
               ELSE
                  ARMF = 0.0
                  ARMR = 0.0
               ENDIF
            ENDIF

            !--------------------------------------------------------
            ! If one side was successfully armed, define:
            !
            ! TZ    = desired capacitor zero-crossing time
            ! TFIRE = placeholder invalid firing time for now
            !
            ! TFIRE will be recomputed continuously until firing.
            !--------------------------------------------------------
            IF (ARMF .GT. 0.5 .OR. ARMR .GT. 0.5) THEN
               TZ    = TIME + TDEL
               TFIRE = TZ + 1.0
            ENDIF

         ENDIF
      ENDIF

      !---------------------------------------------------------------
      ! If an event is armed, keep working on it until:
      !   - it fires, or
      !   - it expires when TIME reaches TZ
      !---------------------------------------------------------------
      IF (ARMF .GT. 0.5 .OR. ARMR .GT. 0.5) THEN

         !------------------------------------------------------------
         ! Time remaining until desired zero crossing.
         !------------------------------------------------------------
         DTZ = TZ - TIME

         !------------------------------------------------------------
         ! If we have already reached/passed TZ without firing,
         ! the event expires and is cleared.
         !------------------------------------------------------------
         IF (DTZ .LE. 0.0) THEN
            ARMF  = 0.0
            ARMR  = 0.0
            TFIRE = TZ + 1.0

         ELSE

            !---------------------------------------------------------
            ! Only solve the SVR equation if the current is not too small.
            !
            ! Later we divide by X0*iL, so we avoid solving if that
            ! denominator is effectively zero.
            !---------------------------------------------------------
            IF (ABS($iL) .GT. CMIN .AND. ABS(X0*$iL) .GT. EPS) THEN

               !------------------------------------------------------
               ! CONSTANT-CURRENT SVR EXTRAPOLATION
               !------------------------------------------------------
               UCZ  = $uC + X0*$iL*LAM*WN*DTZ

               !------------------------------------------------------
               ! Normalize the predicted voltage by X0*iL:
               !
               !   YVAL = UCZ / (X0*iL)
               !------------------------------------------------------
               YVAL = UCZ/(X0*$iL)

               !------------------------------------------------------
               ! Capacitive-mode interval:
               !
               !   0 < lambda*beta < pi/2
               !
               ! We solve for beta only in this valid branch.
               ! Small margin MARG keeps away from the endpoints.
               !------------------------------------------------------
               BLOW  = MARG/LAM
               BHIGH = (0.5*PI - MARG)/LAM

               !------------------------------------------------------
               ! Define the function:
               !
               !   f(beta) = lambda*beta - tan(lambda*beta) - YVAL
               !
               ! We want to find beta such that:
               !
               !   lambda*beta - tan(lambda*beta) - YVAL = 0
               !------------------------------------------------------
               ARG   = LAM*BLOW
               FLOW  = ARG - TAN(ARG) - YVAL

               ARG   = LAM*BHIGH
               FHIGH = ARG - TAN(ARG) - YVAL

               !------------------------------------------------------
               ! A root exists in the interval if the function changes
               ! sign between the endpoints:
               !
               !   FLOW * FHIGH <= 0
               !
               ! Then the root is bracketed and bisection can be used.
               !------------------------------------------------------
               IF (FLOW*FHIGH .LE. 0.0) THEN

                  !---------------------------------------------------
                  ! BISECTION SOLVER
                  !
                  ! Each iteration halves the interval [BLOW, BHIGH].
                  !
                  ! Steps:
                  !   1) evaluate midpoint
                  !   2) check which half contains the sign change
                  !   3) keep that half
                  !
                  ! After NIT iterations, beta is approximated by the
                  ! midpoint of the final interval.
                  !---------------------------------------------------
                  DO ITR = 1, NIT
                     BMID = 0.5*(BLOW + BHIGH)
                     ARG  = LAM*BMID
                     FMID = ARG - TAN(ARG) - YVAL

                     IF (FLOW*FMID .LE. 0.0) THEN
                        ! Root lies between BLOW and BMID
                        BHIGH = BMID
                        FHIGH = FMID
                     ELSE
                        ! Root lies between BMID and BHIGH
                        BLOW = BMID
                        FLOW = FMID
                     ENDIF
                  ENDDO

                  !---------------------------------------------------
                  ! Final beta estimate = midpoint of final bracket.
                  !---------------------------------------------------
                  BETA  = 0.5*(BLOW + BHIGH)

                  !---------------------------------------------------
                  ! Convert firing angle beta into time:
                  !
                  !   TFIRE = TZ - beta/WN
                  !---------------------------------------------------
                  TFIRE = TZ - BETA/WN

               ELSE

                  !---------------------------------------------------
                  ! No valid root found in the allowed interval.
                  !---------------------------------------------------
                  TFIRE = TZ + 1.0

               ENDIF

            ELSE

               !------------------------------------------------------
               ! Current too small or denominator too small for a
               ! reliable solve. Use invalid future TFIRE so that the
               ! event remains armed but cannot fire from this solve.
               !------------------------------------------------------
               TFIRE = TZ + 1.0

            ENDIF

            !---------------------------------------------------------
            ! FIRING CONDITIONS
            !
            ! Even if TFIRE has been computed, the actual pulse is only
            ! sent if:
            !   - current time has reached TFIRE
            !   - we are still within one timestep after TZ
            !   - the physical state still matches the correct side
            !---------------------------------------------------------

            !---------------------------------------------------------
            ! FORWARD THYRISTOR
            !
            ! Forward side fires when:
            !   uC > 0
            !   iL < 0
            !---------------------------------------------------------
            IF (ARMF .GT. 0.5) THEN
               IF (TIME .GE. TFIRE .AND. TIME .LE. TZ + DELT .AND.
     &             $uC .GT. 0.0 .AND. $iL .LT. -CMIN) THEN
                  GTF  = PWID
                  ARMF = 0.0
                  ARMR = 0.0
               ENDIF
            ENDIF

            !---------------------------------------------------------
            ! REVERSE THYRISTOR
            !
            ! Reverse side fires when:
            !   uC < 0
            !   iL > 0
            !---------------------------------------------------------
            IF (ARMR .GT. 0.5) THEN
               IF (TIME .GE. TFIRE .AND. TIME .LE. TZ + DELT .AND.
     &             $uC .LT. 0.0 .AND. $iL .GT. CMIN) THEN
                  GTR  = PWID
                  ARMF = 0.0
                  ARMR = 0.0
               ENDIF
            ENDIF

         ENDIF
      ENDIF

      !---------------------------------------------------------------
      ! OUTPUT PULSE STRETCHING
      !
      ! GTF and GTR store how much longer the output pulse should stay
      ! high. This turns the single firing event into a pulse of width
      ! PWID.
      !---------------------------------------------------------------
      IF (GTF .GT. 0.0) THEN
         $FP = 1.0
         GTF = GTF - DELT
         IF (GTF .LT. 0.0) GTF = 0.0
      ENDIF

      IF (GTR .GT. 0.0) THEN
         $RP = 1.0
         GTR = GTR - DELT
         IF (GTR .LT. 0.0) GTR = 0.0
      ENDIF

      !---------------------------------------------------------------
      ! Store updated internal state for the next timestep.
      !---------------------------------------------------------------
      STORF(K0+1) = $RefPulse
      STORF(K0+2) = ARMF
      STORF(K0+3) = ARMR
      STORF(K0+4) = TZ
      STORF(K0+5) = TFIRE
      STORF(K0+6) = GTF
      STORF(K0+7) = GTR

      !---------------------------------------------------------------
      ! Advance storage pointer so PSCAD knows how many STORF slots
      ! this block has used.
      !---------------------------------------------------------------
      NSTORF = K0 + 7]]></segment>
        <segment name="Branch" id="979838658" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
    </Definition>
